# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# ── Environments ──────────────────────────────────────────────────────────────
.env
.envrc
.venv/
venv/
env/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── Type checkers / linters ───────────────────────────────────────────────────
.mypy_cache/
.ruff_cache/
.pytype/
.pyre/

# ── Test / coverage ───────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDEs ──────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.code-workspace

# ── Internal / sensitive documents ───────────────────────────────────────────
internal_docs/

# ── Bioinformatics data (large files — store externally) ──────────────────────
# Raw input data
data/*
!data/.gitkeep
*.tar
*.tar.gz
*.mtx
*.h5ad 
*.loom

# Processed AnnData files
output/*
!output/.gitkeep
*.h5ad
*.h5

# Analysis results / figures
results/*
!results/.gitkeep
*.pkl
*.pickle

# ── ML model checkpoints ──────────────────────────────────────────────────────
*.pt
*.pth
*.ckpt
*.safetensors

# ── SCENIC intermediate files ─────────────────────────────────────────────────
*.db
*.feather
pyscenic_output/
adj.csv
reg.csv

# ── Logs (run-specific, not part of codebase) ─────────────────────────────────
*.log
logs/*
!logs/.gitkeep
